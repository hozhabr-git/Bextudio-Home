# The local server binds to loopback by default.
HOST=127.0.0.1
PORT=5174
APP_ORIGIN=http://127.0.0.1:5173
# Existing AI services from the original Framer code.
HELIO_API_ORIGIN=https://api.helio.ae
HELIO_API_TOKEN=
AGENT_ACCESS_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Optional contact delivery; submissions are always stored locally first.
CONTACT_WEBHOOK_URL=

ADMIN_EMAIL=admin@bextudio.local
ADMIN_PASSWORD=

# Optional final public origin used for canonical URLs and sitemap.
SITE_URL=
