{
  "name": "bextudio-independent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}